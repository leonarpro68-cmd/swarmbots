<?xml version="1.0"?>
<robot name="summit_xl" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Summit XL std SIN brazo, portado a Gazebo Fortress.
       Solo plugins nativos Ignition (mismas convenciones que
       swarm_description/urdf/minibot.urdf.xacro). No incluye
       all_sensors.urdf.xacro ni ros2_control.urdf.xacro (Classic / brazo). -->

  <!-- Per-robot args (set by spawner) -->
  <xacro:arg name="robot_ns" default="summit"/>
  <xacro:property name="ns" value="$(arg robot_ns)"/>
  <xacro:arg name="prefix" default=""/>

  <!-- Base + ruedas (sin plugins Classic en estos includes) -->
  <xacro:include filename="$(find summit_xl_description)/urdf/bases/summit_xl_base.urdf.xacro"/>
  <xacro:include filename="$(find summit_xl_description)/urdf/wheels/rubber_wheel.urdf.xacro"/>

  <!-- Wheel parameters (de summit_xl_std.urdf.xacro) -->
  <xacro:property name="wheel_offset_x" value="0.218"/>
  <xacro:property name="wheel_offset_y" value="0.218"/>
  <xacro:property name="wheel_offset_z" value="0.0512"/>
  <xacro:property name="wheel_radius"   value="0.11"/>
  <xacro:property name="hq" value="true"/>

  <!-- BASE -->
  <xacro:summit_xl_base prefix="$(arg prefix)" publish_bf="true" hq="${hq}"/>

  <!-- WHEELS (4x rubber, skid-steer) -->
  <xacro:rubber_wheel prefix="front_right_" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
    <origin xyz="${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:rubber_wheel>
  <xacro:rubber_wheel prefix="front_left_" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:rubber_wheel>
  <xacro:rubber_wheel prefix="rear_left_" parent="$(arg prefix)base_link" reflect="true" hq="${hq}">
    <origin xyz="-${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:rubber_wheel>
  <xacro:rubber_wheel prefix="rear_right_" parent="$(arg prefix)base_link" reflect="false" hq="${hq}">
    <origin xyz="-${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:rubber_wheel>

  <!-- LiDAR 2D (sustituye al Sick/Robosense con plugin Classic) -->
  <link name="$(arg prefix)lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="lidar"><color rgba="0.9 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.4e-4" ixy="0" ixz="0" iyy="1.4e-4" iyz="0" izz="1.6e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child  link="$(arg prefix)lidar_link"/>
    <origin xyz="0.324 0 0.24" rpy="0 0 0"/>
  </joint>

  <!-- ============ Gazebo Fortress ============ -->

  <!-- DiffDrive nativo: acepta varios <left_joint>/<right_joint> → skid-steer -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_offset_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/${ns}/cmd_vel</topic>
      <odom_topic>/model/${ns}/odometry</odom_topic>
      <tf_topic>/model/${ns}/tf</tf_topic>
      <frame_id>${ns}/odom</frame_id>
      <child_frame_id>${ns}/base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/model/${ns}/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="$(arg prefix)lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/model/${ns}/scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>540</samples>
            <resolution>1</resolution>
            <min_angle>-2.356</min_angle>
            <max_angle> 2.356</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
