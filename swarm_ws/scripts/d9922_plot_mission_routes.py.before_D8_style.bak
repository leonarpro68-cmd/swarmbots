#!/usr/bin/env python3
"""Mapa de rutas Bézier planificadas para las cuatro etapas ejecutadas D9.9.22."""
import argparse
import json
from math import comb
from pathlib import Path
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import numpy as np

STAGES = [('pickup1', 'Recogida 1'), ('delivery1', 'Entrega 1'),
          ('pickup2', 'Recogida 2'), ('delivery2', 'Entrega 2')]
COLORS = ['tab:blue', 'tab:green', 'tab:red']


def curve_points(controls, n=30):
    # Cada pieza es una Bézier de grado cinco con seis puntos de control.
    xy = []
    for P in controls:
        P = np.asarray(P, dtype=float)
        if P.shape != (6, 2):
            raise ValueError(f'Puntos de control Bézier inesperados: {P.shape}')
        u = np.linspace(0, 1, n, endpoint=False)
        xy.append(sum(comb(5, k) * ((1-u)**(5-k) * u**k)[:, None] * P[k]
                      for k in range(6)))
    xy.append(np.asarray(controls[-1][-1], dtype=float)[None, :])
    return np.vstack(xy)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--stage-windows', required=True)
    ap.add_argument('--output', required=True)
    ap.add_argument('--scenario', default=None, help='Opcional: escenario JSON para depósitos y basuras')
    args = ap.parse_args()
    windows = json.loads(Path(args.stage_windows).read_text(encoding='utf-8'))
    by_stage = {w['stage']: w for w in windows['stages']}
    if len(by_stage) != 4 or any(s not in by_stage for s, _ in STAGES):
        ap.error('Se requieren las cuatro etapas completas; no se inventarán rutas faltantes')
    scenario = None
    if args.scenario and Path(args.scenario).exists():
        scenario = json.loads(Path(args.scenario).read_text(encoding='utf-8'))

    fig, axes = plt.subplots(2, 2, figsize=(13, 15), squeeze=False)
    fig.suptitle('SwarmBots · rutas Bézier planificadas · D9.9.22', fontsize=17, fontweight='bold')
    for idx, (stage, label) in enumerate(STAGES):
        ax = axes.flat[idx]
        w = by_stage[stage]
        with np.load(w['trajectory'], allow_pickle=False) as z:
            for i, col in enumerate(COLORS):
                xy = curve_points(z[f'R{i}_controls'])
                ax.plot(xy[:, 0], xy[:, 1], color=col, lw=2.1, label=f'Summit {i}')
                ax.scatter(xy[0, 0], xy[0, 1], marker='s', s=55, color=col, zorder=5)
                ax.scatter(xy[-1, 0], xy[-1, 1], marker='*', s=100, color=col, zorder=5)
        if isinstance(scenario, dict):
            # Mostrar elementos solo si el esquema incluye posiciones legibles.
            for item in scenario.get('elements', []):
                pos = item.get('xy_m')
                if not isinstance(pos, (list, tuple)) or len(pos) != 2:
                    continue
                kind = str(item.get('type', '')).lower()
                if kind == 'trash':
                    ax.scatter(pos[0], pos[1], marker='o', s=30, color='gray', alpha=.6)
                elif kind == 'deposit':
                    ax.scatter(pos[0], pos[1], marker='D', s=50,
                               color='gray', alpha=.6)
        ax.set_title(f'{label} · duración máxima {float(w["max_duration_s"]):.1f} s')
        ax.set_xlabel('X (m)'); ax.set_ylabel('Y (m)')
        ax.set_aspect('equal', adjustable='datalim')
        ax.grid(alpha=.25)
        ax.legend(loc='best', fontsize=9)
    fig.text(.5, .01, 'Rutas planificadas offline; no representan posiciones medidas por odometría.',
             ha='center', fontsize=10)
    fig.tight_layout(rect=[0,.025,1,.965])
    out = Path(args.output).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(out, dpi=170)
    plt.close(fig)
    print(json.dumps({'status':'PLOT_READY','output':str(out)}, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
