<?xml version='1.0' encoding='UTF-8'?>
<sdf version='1.7'>
  <world name='world_demo'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>-5 -3 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Base. Vendorizado en swarm_worlds/models/ con colisiones primitivas:
         la malla STL original hundía el RTF a ~0.06 con robots dentro.
         Requiere swarm_worlds/models en GZ_SIM_RESOURCE_PATH (lo exporta
         sim_summit.launch.py). -->
    <include>
      <uri>model://warehouse</uri>
      <name>warehouse</name>
      <pose>0 0 -0.09 0 0 0</pose>
    </include>


    <!-- Camara CENITAL: vista superior estatica del ALMACEN ENTERO. Centrada
         en (0,0) a 38 m mirando hacia -Z (pitch +90), FOV 1.3 rad -> cubre
         ~58 m (los 50x30 m del almacen caben). Publica gz.msgs.Image en
         /overhead/image; sim_summit.launch.py la bridgea a ROS. Requiere el
         sistema Sensors (ya esta en el mundo). Para acercar a una zona, baja
         el z o reduce el FOV y recentra el <pose>. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 38 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <topic>/overhead/image</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>900</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>80.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

  
    <model name="trash_V1_verde">
      <pose>3.750000 6.250000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_V2_verde">
      <pose>-11.250000 15.000000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_N1_naranja">
      <pose>-6.250000 -1.250000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.7 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_N2_naranja">
      <pose>10.000000 18.750000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.7 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_A1_azul">
      <pose>2.500000 15.000000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_A2_azul">
      <pose>-2.500000 -10.000000 0.100 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.3</mass><inertia>
          <ixx>1.36e-3</ixx><iyy>1.36e-3</iyy><izz>7.2e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="c"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.12 0.12 0.20</size></box></geometry>
          <material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deposit_verde">
      <static>true</static>
      <pose>3.750000 -13.750000 0.010 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 0.45</ambient><diffuse>0.2 0.6 0.3 0.45</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deposit_naranja">
      <static>true</static>
      <pose>-1.250000 -21.250000 0.010 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.7 0.4 0.2 0.45</ambient><diffuse>0.7 0.4 0.2 0.45</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="deposit_azul">
      <static>true</static>
      <pose>-1.250000 20.000000 0.010 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.3 0.4 0.7 0.45</ambient><diffuse>0.3 0.4 0.7 0.45</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
