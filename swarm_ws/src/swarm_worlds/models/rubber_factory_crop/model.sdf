<?xml version="1.0"?>
<!-- GENERADO por scripts/crop_world.py a partir de worlds/rubber_factory.sdf:
     ventana 30 x 50 m centrada en (-12.79, 58.5) del mundo original,
     trasladada al origen. No editar a mano. -->
<sdf version="1.8">
  <model name="rubber_factory_crop">
    <static>true</static>
    <link name="link">
      <collision name="emka_factory__collision">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__link_1__collision.stl</uri></mesh></geometry>
        <laser_retro>0</laser_retro><max_contacts>10</max_contacts><surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
      <visual name="emka_factory__machine0">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine0__vis.stl</uri></mesh></geometry>
        <material><ambient>0.72 0.12 0.14 1</ambient><diffuse>0.72 0.12 0.14 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__small">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__small__vis.stl</uri></mesh></geometry>
        <material><ambient>0.16 0.16 0.18 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__machine1">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine1__vis.stl</uri></mesh></geometry>
        <material><ambient>0.92 0.76 0.12 1</ambient><diffuse>0.92 0.76 0.12 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__machine2">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine2__vis.stl</uri></mesh></geometry>
        <material><ambient>0.46 0.26 0.62 1</ambient><diffuse>0.46 0.26 0.62 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__machine3">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine3__vis.stl</uri></mesh></geometry>
        <material><ambient>0.93 0.93 0.95 1</ambient><diffuse>0.93 0.93 0.95 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__machine4">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine4__vis.stl</uri></mesh></geometry>
        <material><ambient>0.92 0.76 0.12 1</ambient><diffuse>0.92 0.76 0.12 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__machine5">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__machine5__vis.stl</uri></mesh></geometry>
        <material><ambient>0.72 0.12 0.14 1</ambient><diffuse>0.72 0.12 0.14 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="emka_factory__wall">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__wall__vis.stl</uri></mesh></geometry>
        <material><ambient>0.58 0.22 0.18 1</ambient><diffuse>0.58 0.22 0.18 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
