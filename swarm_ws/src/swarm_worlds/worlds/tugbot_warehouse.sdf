    </model>

    <model name="trash_crate_1">
      <pose>1.0 17.8 0.09 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.15</mass>
          <inertia><ixx>4.5e-4</ixx><iyy>4.5e-4</iyy><izz>9.0e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.06 0.06 0.18</size></box></geometry>
