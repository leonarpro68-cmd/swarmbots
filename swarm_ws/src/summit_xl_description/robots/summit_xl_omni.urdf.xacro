<?xml version="1.0"?>
<robot name="summit_xls" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Summit XLS (ruedas mecanum/omni) para Gazebo Harmonic, pensado para
       spawneo en enjambre (N instancias con namespace propio).

       Usa el plugin nativo MecanumDrive. OJO: la fricción direccional de las
       ruedas mecanum (fdir1 con gz:expressed_in) NO es expresable en
       URDF; la inyecta sim_summit.launch.py al convertir URDF→SDF. Aquí solo
       se fija mu1=1.0 / mu2=0.0 por rueda.

       No usa omni_wheel.urdf.xacro de Robotnik (mu=0, sin tracción, y PI sin
       definir) ni los macros Classic de summit_xl_base.gazebo.xacro. -->

  <!-- Per-robot args (set by spawner) -->
  <xacro:arg name="robot_ns" default="summit0"/>
  <xacro:property name="ns" value="$(arg robot_ns)"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="gripper" default="false"/>

  <xacro:include filename="$(find summit_xl_description)/urdf/bases/summit_xls_base.urdf.xacro"/>
  <xacro:include filename="$(find summit_xl_description)/urdf/gripper.urdf.xacro"/>

  <!-- Parámetros (de summit_xls.urdf.xacro / omni_wheel.urdf.xacro) -->
  <xacro:property name="wheel_offset_x" value="0.2225"/>
  <xacro:property name="wheel_offset_y" value="0.2045"/>
  <xacro:property name="wheel_offset_z" value="0.0"/>
  <xacro:property name="wheel_radius"   value="0.127"/>
  <xacro:property name="wheel_width"    value="0.087"/>
  <xacro:property name="wheel_mass"     value="6.5"/>
  <xacro:property name="hq" value="true"/>

  <!-- BASE -->
  <xacro:summit_xls_base prefix="$(arg prefix)" publish_bf="true" hq="${hq}"/>

  <!-- RUEDA MECANUM (visual Robotnik + colisión cilindro + fricción direccional) -->
  <xacro:macro name="mecanum_wheel" params="prefix reflect *origin">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <xacro:insert_block name="origin"/>
      <parent link="$(arg prefix)base_link"/>
      <child link="${prefix}_wheel_link"/>
      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="100" velocity="100"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <xacro:if value="${reflect}">
            <mesh filename="file://$(find summit_xl_description)/meshes/wheels/omni_wheel_1.dae"/>
          </xacro:if>
          <xacro:unless value="${reflect}">
            <mesh filename="file://$(find summit_xl_description)/meshes/wheels/omni_wheel_2.dae"/>
          </xacro:unless>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0"/>
        <!-- cilindro con eje en Y (eje de giro de la rueda) -->
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_radius*wheel_radius/2}" iyz="0"
                 izz="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"/>
      </inertial>
    </link>

    <!-- mu2=0: sin fricción lateral en la dirección del rodillo. El fdir1
         (±45°, expressed_in chassis) lo inyecta el launch en el SDF. -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_right" reflect="false">
    <origin xyz="${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:mecanum_wheel>
  <xacro:mecanum_wheel prefix="front_left" reflect="true">
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:mecanum_wheel>
  <xacro:mecanum_wheel prefix="back_left" reflect="true">
    <origin xyz="-${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:mecanum_wheel>
  <xacro:mecanum_wheel prefix="back_right" reflect="false">
    <origin xyz="-${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
  </xacro:mecanum_wheel>

  <!-- Pinza paralela al frente (solo si gripper:=true) -->
  <xacro:if value="$(arg gripper)">
    <xacro:summit_gripper prefix="$(arg prefix)"/>
    <!-- gz_ros2_control: arranca un controller_manager por robot que actua
         sobre los dedos. Va en namespace ${ns} para alinearse con el
         robot_state_publisher namespaceado (de donde el plugin lee el
         <ros2_control> del robot_description) -> controller_manager en
         /${ns}/controller_manager. El YAML usa claves comodin /** para casar
         con cualquier namespace. -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find summit_xl_description)/config/gripper_controllers.yaml</parameters>
        <ros>
          <namespace>${ns}</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- LiDAR 2D sobre la tapa del chasis -->
  <link name="$(arg prefix)lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="lidar"><color rgba="0.9 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.4e-4" ixy="0" ixz="0" iyy="1.4e-4" iyz="0" izz="1.6e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child  link="$(arg prefix)lidar_link"/>
    <origin xyz="0.25 0 0.43" rpy="0 0 0"/>
  </joint>

  <!-- IMU en el centro del chasis (sobre base_link). Frame ENU del sensor. -->
  <link name="$(arg prefix)imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child  link="$(arg prefix)imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ============ Gazebo Harmonic ============ -->

  <!-- MecanumDrive nativo. Se suscribe a /model/<nombre_modelo>/cmd_vel
       (el nombre del modelo lo fija el spawner = namespace).
       OJO (Harmonic): a diferencia de Fortress, el MecanumDrive SÍ publica
       odometría y tf por su cuenta (dead-reckoning, en frame del spawn). Si se
       deja en los tópicos por defecto colisiona con el OdometryPublisher (que
       da la pose MUNDO) en /model/<ns>/odometry y /model/<ns>/tf -> el bridge
       mezcla ambas y la odom sale alternando mundo/relativa (rompe el
       comportamiento). Se redirige su odom/tf a tópicos propios NO usados. -->
  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>back_left_wheel_joint</back_left_joint>
      <back_right_joint>back_right_wheel_joint</back_right_joint>
      <wheel_separation>${2*wheel_offset_y}</wheel_separation>
      <wheelbase>${2*wheel_offset_x}</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_topic>/model/${ns}/mecanum_odom</odom_topic>
      <tf_topic>/model/${ns}/mecanum_tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- El MecanumDrive de Harmonic anuncia odometría pero nunca la publica;
       se usa OdometryPublisher (ground truth del motor de física). -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>${ns}/odom</odom_frame>
      <robot_base_frame>${ns}/base_footprint</robot_base_frame>
      <odom_topic>/model/${ns}/odometry</odom_topic>
      <tf_topic>/model/${ns}/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${ns}/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- IMU nativo Harmonic. Requiere el sistema Imu en el <world> (ya esta en
       tugbot_warehouse.sdf y empty_arena.sdf). Publica gz.msgs.IMU. -->
  <gazebo reference="$(arg prefix)imu_link">
    <sensor name="imu" type="imu">
      <topic>/model/${ns}/imu</topic>
      <gz_frame_id>${ns}/imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <enable_orientation>true</enable_orientation>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="$(arg prefix)lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/model/${ns}/scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>540</samples>
            <resolution>1</resolution>
            <min_angle>-2.356</min_angle>
            <max_angle> 2.356</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
