      <pose>0.7 18.0 0.09 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.15</mass>
          <inertia><ixx>4.66e-4</ixx><iyy>4.36e-4</iyy><izz>9.25e-5</izz>
