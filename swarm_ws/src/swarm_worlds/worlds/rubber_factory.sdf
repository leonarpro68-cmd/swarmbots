<?xml version='1.0' encoding='utf-8'?>
<!-- ==========================================================================
     rubber_factory.sdf  -  nave industrial (planta de fabrica de caucho)

     Origen: RobotnikAutomation/robotnik_gazebo_worlds, rama jazzy-devel,
     paquete rubber_factory_world (licencia BSD). El modelo emka_factory queda
     VENDORIZADO en swarm_worlds/models/emka_factory (0.35 MB, solo el STL en
     uso; no se copia el emka_factory_OLD.stl) -> sin Fuel ni internet.

     Adaptaciones (todas aqui, no se toca ningun otro mundo):
       - <world name> -> world_demo (lo que esperan central_planner y
         grasp_manager por defecto).
       - <static>true</static> en el include de la fabrica. EL ORIGINAL NO LO
         TRAE: el modelo declara masa 1 kg, asi que la nave entera era un
         cuerpo DINAMICO que los robots podian empujar.
       - <physics> ode max_step_size 0.004, igual que tugbot_warehouse (el
         agarre RGB-D y el DetachableJoint estan afinados a ese paso).
       - plugins Harmonic completos, incluido Imu (sin el no hay /summitN/imu).
       - camara cenital /overhead/image.

     Geometria: planta de 91 x 121 m extruida 2 m de alto (paredes y tabiques,
     SIN techo -> la cenital ve el interior). La colision es la MISMA malla:
     7088 triangulos, 5232 de ellos en la banda de altura que ve el robot. Es
     el patron que hundio el RTF con la malla del almacen, por eso se midio en
     vivo antes de dar el mundo por bueno (ver mensaje del commit).

     Zona util medida rasterizando el STL: la nave grande del norte,
     area_half 14 m centrada en (-15.3, 85.5). Es el unico mundo del set,
     ademas del almacen, donde cabe el escenario a tamano completo.
     ========================================================================== -->
<sdf version="1.8">
  <world name="world_demo">

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <pose>-30 60 0 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>100 130</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <pose>-30 60 0 0 0 0</pose>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 130</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- La nave. static=true anadido aqui a proposito (ver cabecera). -->
    <include>
      <uri>model://emka_factory</uri>
      <name>emka_factory</name>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Camara CENITAL sobre la nave util: mismo topico y resolucion que en
         los demas mundos. A 26 m con FOV 1.3 rad cubre ~40 m, que envuelve
         el cuadrado libre de 28 m de lado. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>-15.3 85.5 26 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <topic>/overhead/image</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>900</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>60.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
