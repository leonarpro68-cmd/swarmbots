<?xml version='1.0' encoding='utf-8'?>
<!-- ==========================================================================
     electrical_substation.sdf  -  subestacion electrica AL AIRE LIBRE,
     RECORTADA a 30 x 50 m (el tamano de tugbot_warehouse)

     Origen: RobotnikAutomation/robotnik_gazebo_worlds, rama jazzy-devel,
     paquete electrical_substation_world (licencia BSD, ver package.xml del
     repo origen).

     RECORTE (scripts/crop_world.py, opcion rotate90): ventana de 50 x 30 m centrada
     en (-40.69, 21.77) del original, trasladada al origen y GIRADA +90 grados
     para quedar en 30 x 50 como tugbot. Contiene la explanada del noroeste
     (spawn), la esquina norte del patio vallado con aparamenta, los edificios
     del oeste, la caseta y la estacion de carga del Summit y parte de la casa
     (19 m de alto, cortada por el borde: desde la cenital se ve abierta).
     Elegida con scripts/measure_safe_zones.py: 12.4 m libres desde (0,0) sobre
     suelo PLANO a z=0 (la losa station_base esta a +3 cm y enterraria los
     depositos), asi que el spawn por defecto (area_half 8) funciona sin
     argumentos. Trozos en models/electrical_substation_crop (generado; los
     modelos originales se borraron del repo, estan en la historia de git).
     Cerrado con 4 paredes perimetrales de 2.5 m en x=+-15 / y=+-25 y la misma
     camara cenital que tugbot (0,0,38 m). Sol y ground_plane girados con el
     recorte.

     BUG DEL ORIGINAL ELIMINADO: el marcador AR del summit_docking_station es
     un <plane> de COLISION, y en gz-physics un plano de colision es INFINITO:
     cruzaba toda la subestacion como un muro invisible (medido: un robot se
     paraba en seco a 17 m de la estacion). En el recorte esa colision es una
     malla finita de 0.14 m; verificado en vivo que el robot pasa.

     Adaptaciones (todas en este fichero, no se toca ningun otro mundo):
       - <world name> -> world_demo (lo que esperan central_planner y
         grasp_manager por defecto)
       - <physics> ode max_step_size 0.004 en vez de 0.02/50Hz: el agarre
         RGB-D y el DetachableJoint estan afinados a ese paso
       - quitado el plugin NavSat (ningun robot nuestro lleva ese sensor) y
         el <gui><camera>
       - camara CENITAL /overhead/image

     Es el mundo EXTERIOR del set: suelo, iluminacion y fondo completamente
     distintos a los almacenes -> la variacion que mas ayuda a que la politica
     ACT no aprenda el decorado. El actor (operario) del original patrullaba el
     centro del patio, fuera del recorte: ya no esta (tampoco su descarga de
     Fuel por internet).
     ========================================================================== -->
<sdf version="1.8">
  <world name="world_demo">

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>21.77 40.69 0 0 -0 1.5708</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <pose>21.77 40.69 0 0 -0 1.5708</pose>
        <static>true</static>
        <link name="link">
            <collision name="collision">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                </plane>
            </geometry>
            </collision>
            <visual name="visual">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>500 500</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.8 0.8 0.8 1</specular>
            </material>
            </visual>
        </link>
    </model>

    <!-- Camara CENITAL, igual que en tugbot_warehouse: (0,0) a 38 m, FOV 1.3
         rad -> cubre ~58 m, el recorte de 30 x 50 m entero. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 38 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <topic>/overhead/image</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>900</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>80.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- Recorte 30 x 50 m del mundo original (scripts/crop_world.py) -->
    <include>
      <uri>model://electrical_substation_crop</uri>
      <name>electrical_substation_crop</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Paredes perimetrales del recorte (crop_world.py): caras interiores en
         x=+-14.75, y=+-24.75. 2.5 m de alto: el LiDAR las
         ve y no tapan la cenital. -->
    <model name="perimeter_walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_north_collision"><pose>0 25.0 1.25 0 0 0</pose>
          <geometry><box><size>30.5 0.5 2.5</size></box></geometry></collision>
        <visual name="wall_north_visual"><pose>0 25.0 1.25 0 0 0</pose>
          <geometry><box><size>30.5 0.5 2.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
        <collision name="wall_south_collision"><pose>0 -25.0 1.25 0 0 0</pose>
          <geometry><box><size>30.5 0.5 2.5</size></box></geometry></collision>
        <visual name="wall_south_visual"><pose>0 -25.0 1.25 0 0 0</pose>
          <geometry><box><size>30.5 0.5 2.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
        <collision name="wall_east_collision"><pose>15.0 0 1.25 0 0 0</pose>
          <geometry><box><size>0.5 50.5 2.5</size></box></geometry></collision>
        <visual name="wall_east_visual"><pose>15.0 0 1.25 0 0 0</pose>
          <geometry><box><size>0.5 50.5 2.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
        <collision name="wall_west_collision"><pose>-15.0 0 1.25 0 0 0</pose>
          <geometry><box><size>0.5 50.5 2.5</size></box></geometry></collision>
        <visual name="wall_west_visual"><pose>-15.0 0 1.25 0 0 0</pose>
          <geometry><box><size>0.5 50.5 2.5</size></box></geometry>
          <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
