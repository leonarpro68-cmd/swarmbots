<?xml version='1.0'?>
<!-- Warehouse de MovAi (Fuel) vendorizado y ADAPTADO para enjambres:
     la colisión original era UNA malla STL (3192 tris) cuyo AABB (30x50x12.6 m)
     envuelve todo el interior; con cualquier robot dentro, DART hace
     narrowphase malla-vs-robot en cada paso y el RTF cae a ~0.06.
     Se sustituye por primitivas: caja de suelo (tope a z=0.099, igual que el
     STL original) + 4 paredes perimetrales a x=±15 / y=±25 de altura completa
     (los drones no pueden escaparse por encima). El lidar no cambia: raya
     contra los visuales, que se conservan intactos. -->
<sdf version="1.8">
    <model name="warehouse">
        <pose>0 0 0 0 0 0</pose>
        <self_collide>false</self_collide>
        <static>true</static>
        <link name="warehouse_base">
            <pose>0 0 0 0 0 0</pose>
            <collision name="floor_collision">
                <pose>0 0 0.049 0 0 0</pose>
                <geometry>
                    <box><size>30 50 0.1</size></box>
                </geometry>
            </collision>
            <collision name="wall_north_collision">
                <pose>0 25 6.35 0 0 0</pose>
                <geometry>
                    <box><size>31 0.5 12.5</size></box>
                </geometry>
            </collision>
            <collision name="wall_south_collision">
                <pose>0 -25 6.35 0 0 0</pose>
                <geometry>
                    <box><size>31 0.5 12.5</size></box>
                </geometry>
            </collision>
            <collision name="wall_east_collision">
                <pose>15 0 6.35 0 0 0</pose>
                <geometry>
                    <box><size>0.5 51 12.5</size></box>
                </geometry>
            </collision>
            <collision name="wall_west_collision">
                <pose>-15 0 6.35 0 0 0</pose>
                <geometry>
                    <box><size>0.5 51 12.5</size></box>
                </geometry>
            </collision>
            <visual name="warehouse_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/warehouse.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="drop_area_visual">
                <pose>0 0 0.101 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/warehouse.dae</uri>
                        <submesh>
                            <name>drop1</name>
                            <center>true</center>
                        </submesh>
                    </mesh>
                </geometry>
            </visual>
        </link>
    </model>
</sdf>
