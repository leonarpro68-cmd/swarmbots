<?xml version="1.0"?>
<!-- GENERADO por scripts/crop_world.py a partir de worlds/rubber_factory.sdf:
     ventana 30 x 50 m centrada en (-12.79, 58.5) del mundo original,
     trasladada al origen. No editar a mano. -->
<sdf version="1.8">
  <model name="rubber_factory_crop">
    <static>true</static>
    <link name="link">
      <collision name="emka_factory__collision">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__link_1__collision.stl</uri></mesh></geometry>
        <laser_retro>0</laser_retro><max_contacts>10</max_contacts><surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
      <visual name="emka_factory__visual">
        <geometry><mesh><uri>model://rubber_factory_crop/meshes/emka_factory__link_1__visual__vis.stl</uri></mesh></geometry>
        <material>
          <lighting>1</lighting>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <shader type="vertex">
            <normal_map>__default__</normal_map>
          </shader>
        </material><transparency>0</transparency><cast_shadows>1</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
