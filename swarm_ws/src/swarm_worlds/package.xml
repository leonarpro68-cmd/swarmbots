<?xml version="1.0"?>
<package format="3">
  <name>swarm_worlds</name>
  <version>0.1.0</version>
  <description>Worlds and multi-robot launchers for swarm simulation in Gazebo Harmonic.</description>
  <maintainer email="leonarpro68@gmail.com">leo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>swarm_description</exec_depend>
  <exec_depend>xacro</exec_depend>
