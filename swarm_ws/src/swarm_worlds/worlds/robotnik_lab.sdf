<?xml version='1.0' encoding='utf-8'?>
<!-- ==========================================================================
     robotnik_lab.sdf  -  laboratorio/oficina de Robotnik (interior estrecho)

     Origen: RobotnikAutomation/robotnik_gazebo_worlds, rama jazzy-devel,
     paquete robotnik_lab_world, fichero robotnik_lab_simplifyed.world
     (licencia BSD). Mallas VENDORIZADAS en swarm_worlds/models/office y
     swarm_worlds/models/others -> sin Fuel ni internet. Se copian SOLO las
     que el mundo usa: ROB_office, ROB_long_table, ROB_work_station (.dae +
     su textura) y fruit_box. Quedan fuera apple.stl (7.2 MB) y
     ROB_work_station.stl (5.3 MB), que este mundo no referencia.

     Adaptaciones (todas aqui, ningun otro mundo se toca):
       - <world name> -> world_demo (lo que esperan central_planner y
         grasp_manager por defecto).
       - Fuera el <state> (volcado de una sesion de Gazebo Classic que duplica
         cada modelo con su pose instantanea) y el <gui>.
       - Fuera los atributos frame="" de los <pose> (tag de Classic).
       - <physics> ode max_step_size 0.004 igual que tugbot_warehouse: el
         agarre RGB-D y el DetachableJoint estan afinados a ese paso.
       - Plugins Harmonic completos, incluido Imu (sin el no hay /summitN/imu).
       - Visual de las cajas de fruta: fruit_box.dae -> .stl. El .dae pide
         una textura que el repo origen NO incluye
         (14029_plastic_fruit_crate_diff.jpg) y Gazebo soltaba un [Err] en
         cada arranque; el .stl es la misma geometria (ya se usaba para la
         colision) y no necesita textura.
       - Anadido un ground_plane (el original se apoyaba en el suelo del
         edificio) y la camara cenital /overhead/image.

     Geometria: nave-oficina de 16 x 62 m y 4.2 m de alto con 43 estaciones de
     trabajo (mesa + silla), 2 mesas largas y 3 cajas de fruta. Es el mundo mas
     ABARROTADO del set: lo mas parecido a la oficina/departamento que no se
     podia usar tal cual de otros repos (todas tenian techo o colisiones de
     malla pesadas).
       - SIN techo: el STL solo tiene 10 triangulos horizontales a z=4.04 m
         (5 m2 de dinteles) frente a 992 m2 de suelo -> la cenital ve dentro.
       - Colisiones baratas: las 43 estaciones son CAJAS de 1.5x1.5x1.2; solo
         el edificio (130 triangulos), 2 mesas y 3 cajas usan malla.

     Zona util medida rasterizando cajas + paredes en la banda z 0.15-0.75 m:
     area_half 5.2 m centrada en (3.7, -19.0), la sala libre del extremo sur.
     ========================================================================== -->
<sdf version="1.8">
  <world name="world_demo">

    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>1</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
        <cast_shadows>1</cast_shadows>
        <pose>0 0 10 0 -0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
        <spot>
          <inner_angle>0</inner_angle>
          <outer_angle>0</outer_angle>
          <falloff>0</falloff>
        </spot>
      </light>
      <model name="ROB_office">
        <static>1</static>
        <link name="link">
          <visual name="visual">
            <geometry>
              <mesh>
                <uri>model://office/meshes/ROB_office/ROB_office.stl</uri>
                <scale>1 1 1</scale>
              </mesh>
            </geometry>
          </visual>
          <collision name="collision">
            <laser_retro>0</laser_retro>
            <max_contacts>10</max_contacts>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
              <mesh>
                <uri>model://office/meshes/ROB_office/ROB_office.stl</uri>
                <scale>1 1 1</scale>
              </mesh>
            </geometry>
            <surface>
              <contact>
                <ode />
              </contact>
              <bounce />
              <friction>
                <torsional>
                  <ode />
                </torsional>
                <ode />
              </friction>
            </surface>
          </collision>
          <velocity_decay>
            <linear>0</linear>
            <angular>0</angular>
          </velocity_decay>
          <self_collide>0</self_collide>
          <kinematic>0</kinematic>
          <gravity>1</gravity>
          <enable_wind>0</enable_wind>
        </link>
        <pose>1.72387 -0.606451 0 0 -0 0</pose>
      </model>
