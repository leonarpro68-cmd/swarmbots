    <!-- Camara CENITAL sobre la sala libre del sur, por encima de los muros
         (4.2 m). A 15 m con FOV 1.3 rad cubre ~23 m: la sala de 10.4 m de
         lado mas el entorno. Mismo topico y resolucion que los demas mundos. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>3.7 -19.0 15 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <topic>/overhead/image</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>900</width><height>900</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>40.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
